<Window x:Class="MaintenanceRecordApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MaintenanceRecordApp.Views"
        Title="管网维修"
        Width="1180"
        Height="760"
        MinWidth="940"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        Icon="/MaintenanceRecord;component/Assets/app.ico"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                Background="{StaticResource DeepGreenBrush}"
                ClipToBounds="True">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Ellipse Grid.RowSpan="5"
                         Width="250"
                         Height="250"
                         Fill="#14FFFFFF"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,-95,-110,0"
                         IsHitTestVisible="False" />
                <Ellipse Grid.RowSpan="5"
                         Width="190"
                         Height="190"
                         Fill="#0FFFFFFF"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom"
                         Margin="-100,0,0,-75"
                         IsHitTestVisible="False" />

                <StackPanel Margin="10,18,10,34">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/MaintenanceRecord;component/Assets/app.png"
                               Width="46"
                               Height="46"
                               Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="管网维修"
                                       Foreground="White"
                                       FontSize="22"
                                       FontWeight="Bold" />
                            <TextBlock Text="维修台账与记录输出"
                                       Foreground="#B4D9D1"
                                       FontSize="11"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <ListBox x:Name="NavigationList"
                         Grid.Row="1"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavigationItemStyle}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button x:Name="ImportUsbButton"
                        Grid.Row="2"
                        Content="一键U盘导入"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="42"
                        Margin="10,10,10,4"
                        Click="ImportFromUsb_Click" />

                <Button x:Name="BackupUsbButton"
                        Grid.Row="3"
                        Content="一键U盘备份"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="42"
                        Margin="10,0,10,4"
                        Click="BackupToUsb_Click" />

                <StackPanel Grid.Row="4" Margin="10,8,10,4">
                    <TextBlock Text="本地数据库"
                               Foreground="#7FA89D"
                               FontSize="10" />
                    <TextBlock Text="{Binding DataDirectory}"
                               Foreground="#A7C8BF"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <TextBlock Text="今日 · 维修记录 · 库 · 图片"
                               Foreground="#6F998F"
                               FontSize="9"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <TextBlock Text="版本 4.1.0"
                               Foreground="#7FA89D"
                               FontSize="10"
                               Margin="0,10,0,0" />
                    <TextBlock Text="© 且萌且机制"
                               Foreground="#6F998F"
                               FontFamily="Microsoft YaHei UI"
                               FontWeight="Light"
                               FontSize="9"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="MainContent"
              Grid.Row="0"
              Grid.Column="1"
              Margin="24,20,24,16">
            <views:NewRecordView Visibility="{Binding SelectedPageIndex, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=0}" />
            <views:RecordsView Visibility="{Binding SelectedPageIndex, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=1}" />
            <views:MaterialsView Visibility="{Binding SelectedPageIndex, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=2}" />
            <views:OptionsView Visibility="{Binding SelectedPageIndex, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=3}" />
        </Grid>

        <Border Grid.Row="1"
                Grid.Column="1"
                Background="#E8EFEC"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,0">
            <DockPanel VerticalAlignment="Center">
                <Ellipse Width="7"
                         Height="7"
                         Fill="{StaticResource GreenBrush}"
                         Margin="0,0,8,0" />
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
