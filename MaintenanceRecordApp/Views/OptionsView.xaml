<UserControl x:Class="MaintenanceRecordApp.Views.OptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="选项管理"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}" />
            <TextBlock Text="在表单中也可以直接输入新选项，保存记录时会自动加入这里。"
                       FontSize="12"
                       Foreground="{StaticResource MutedBrush}"
                       Margin="0,5,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Background="{StaticResource MintBrush}"
                Padding="14"
                Margin="0,0,0,14">
            <TextBlock Text="固定单据来源：客服转单、热线、巡检、外业、其他"
                       FontSize="11"
                       Foreground="{StaticResource DeepGreenBrush}" />
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="维修方式" Style="{StaticResource SectionTitleStyle}" />
                    <ListBox x:Name="RepairMethodList"
                             Grid.Row="1"
                             ItemsSource="{Binding RepairMethods}"
                             Margin="0,0,0,12" />
                    <TextBox x:Name="RepairMethodInput"
                             Grid.Row="2"
                             Style="{StaticResource InputTextBoxStyle}"
                             ToolTip="输入新值，或选择列表项后修改" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="添加"
                                Tag="repair_method"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="12,6"
                                Click="AddOption_Click" />
                        <Button Content="重命名"
                                Tag="repair_method"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,6"
                                Margin="7,0,0,0"
                                Click="RenameOption_Click" />
                        <Button Content="删除"
                                Tag="repair_method"
                                Style="{StaticResource DangerButtonStyle}"
                                Padding="12,6"
                                Margin="7,0,0,0"
                                Click="DeleteOption_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="维修人员" Style="{StaticResource SectionTitleStyle}" />
                    <ListBox x:Name="RepairPersonList"
                             Grid.Row="1"
                             ItemsSource="{Binding RepairPeople}"
                             Margin="0,0,0,12" />
                    <TextBox x:Name="RepairPersonInput"
                             Grid.Row="2"
                             Style="{StaticResource InputTextBoxStyle}"
                             ToolTip="输入新值，或选择列表项后修改" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="添加"
                                Tag="repair_person"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="12,6"
                                Click="AddOption_Click" />
                        <Button Content="重命名"
                                Tag="repair_person"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,6"
                                Margin="7,0,0,0"
                                Click="RenameOption_Click" />
                        <Button Content="删除"
                                Tag="repair_person"
                                Style="{StaticResource DangerButtonStyle}"
                                Padding="12,6"
                                Margin="7,0,0,0"
                                Click="DeleteOption_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="劳务公司" Style="{StaticResource SectionTitleStyle}" />
                    <ListBox x:Name="LaborCompanyList"
                             Grid.Row="1"
                             ItemsSource="{Binding LaborCompanies}"
                             Margin="0,0,0,12" />
                    <TextBox x:Name="LaborCompanyInput"
                             Grid.Row="2"
                             Style="{StaticResource InputTextBoxStyle}"
                             ToolTip="输入新值，或选择列表项后修改" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="添加"
                                Tag="labor_company"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="12,6"
                                Click="AddOption_Click" />
                        <Button Content="重命名"
                                Tag="labor_company"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,6"
                                Margin="7,0,0,0"
                                Click="RenameOption_Click" />
                        <Button Content="删除"
                                Tag="labor_company"
                                Style="{StaticResource DangerButtonStyle}"
                                Padding="12,6"
                                Margin="7,0,0,0"
                                Click="DeleteOption_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
