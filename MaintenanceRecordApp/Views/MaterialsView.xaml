<UserControl x:Class="MaintenanceRecordApp.Views.MaterialsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="导入材料表"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,8,0"
                        Click="ImportMaterials_Click" />
                <Button Content="下载材料模板"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        Click="CreateTemplate_Click" />
                <Button Content="导出材料库"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="ExportMaterials_Click" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="材料库"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="{Binding MaterialCount, StringFormat=当前共 {0} 条材料 · 名称、规格、单位、价格统一管理}"
                           FontSize="12"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,5,0,0" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Background="{StaticResource MintBrush}"
                Padding="14"
                Margin="0,0,0,10">
            <TextBlock Text="支持表头：材料名称、规格型号、单位、价格。新增或修改材料后会自动同步到“文档\管网维修\材料库导入模板.xlsx”；相同名称、规格和单位只保留一条。"
                       FontSize="11"
                       Foreground="{StaticResource DeepGreenBrush}"
                       TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Padding="14"
                Margin="0,0,0,10">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="人工新增材料"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0" />
                    <TextBlock Text="输入名称时会显示材料库中相似材料，避免重复录入"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </DockPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="材料名称" Style="{StaticResource FormLabelStyle}" />
                        <TextBox x:Name="NewMaterialNameBox"
                                 Text="{Binding NewMaterialName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="规格型号" Style="{StaticResource FormLabelStyle}" />
                        <TextBox Text="{Binding NewMaterialSpecification, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="单位" Style="{StaticResource FormLabelStyle}" />
                        <TextBox Text="{Binding NewMaterialUnit, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="价格（元，可留空）" Style="{StaticResource FormLabelStyle}" />
                        <TextBox Text="{Binding NewMaterialPriceText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}" />
                    </StackPanel>
                    <Button Grid.Column="8"
                            Content="加入材料库"
                            Style="{StaticResource PrimaryButtonStyle}"
                            VerticalAlignment="Bottom"
                            Click="AddManualMaterial_Click" />
                </Grid>
                <Border Margin="0,10,0,0"
                        Background="#F8FBFA"
                        CornerRadius="8"
                        Padding="10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSimilarCatalogMaterials}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="已入库相似材料（请优先选择或更新，无需重复新增）"
                                   FontSize="10"
                                   Foreground="#8B5736"
                                   FontWeight="SemiBold" />
                        <ListBox ItemsSource="{Binding SimilarCatalogMaterials}"
                                 MaxHeight="92"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Margin="0,5,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Specification, StringFormat=  ·  {0}}" />
                                        <TextBlock Text="{Binding Unit, StringFormat=  ·  {0}}" />
                                        <TextBlock Text="{Binding Price, StringFormat=  ·  ¥{0:0.00}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding SearchCatalogText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource InputTextBoxStyle}"
                     ToolTip="输入材料名称、规格或单位进行检索" />
            <Button Grid.Column="2"
                    Content="新增空白行"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="AddMaterial_Click" />
        </Grid>

        <DataGrid x:Name="MaterialsGrid"
                  Grid.Row="4"
                  ItemsSource="{Binding FilteredCatalog}"
                  SelectedItem="{Binding SelectedCatalogMaterial, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="材料名称"
                                    Width="*"
                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="规格型号"
                                    Width="190"
                                    Binding="{Binding Specification, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="单位"
                                    Width="110"
                                    Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="价格（元）"
                                    Width="140"
                                    Binding="{Binding Price, UpdateSourceTrigger=PropertyChanged, StringFormat=0.00}" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <TextBlock Text="双击表格单元格可继续修改"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0" />
            <Button Content="保存选中材料"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,0,8,0"
                    Click="SaveMaterial_Click" />
            <Button Content="删除选中材料"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="DeleteMaterial_Click" />
        </StackPanel>
    </Grid>
</UserControl>
