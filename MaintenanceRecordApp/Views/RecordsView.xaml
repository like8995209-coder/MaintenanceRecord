<UserControl x:Class="MaintenanceRecordApp.Views.RecordsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Right"
                    Content="新增维修记录"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="NewRecord_Click" />
            <StackPanel>
                <TextBlock Text="台账记录"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="{Binding RecordCount, StringFormat=共 {0} 条}"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding TodayCount, StringFormat=  ·  今日 {0} 条}"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding UnfinishedCount, StringFormat=  ·  未完毕 {0} 条}"
                               FontSize="12"
                               Foreground="#A64B42" />
                    <TextBlock Text="{Binding CompletedCount, StringFormat=  ·  已完成 {0} 条}"
                               FontSize="12"
                               Foreground="{StaticResource GreenBrush}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding SearchRecordText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource InputTextBoxStyle}"
                     ToolTip="搜索维修编号、外业工单、地点、维修人员或维修原因" />
            <Button Grid.Column="2"
                    Content="导出筛选台账 Excel"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="ExportLedger_Click" />
            <Button Grid.Column="4"
                    Content="今日情况 PDF"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="ExportTodayPdf_Click" />
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Padding="12"
                Margin="0,0,0,12">
            <WrapPanel>
                <StackPanel Width="238" Margin="0,0,10,0">
                    <TextBlock Text="维修日期范围" Style="{StaticResource FormLabelStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="112" />
                        </Grid.ColumnDefinitions>
                        <DatePicker SelectedDate="{Binding FilterStartDate, Mode=TwoWay}"
                                    Style="{StaticResource InputDatePickerStyle}"
                                    ToolTip="开始日期" />
                        <TextBlock Grid.Column="1"
                                   Text="至"
                                   Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <DatePicker Grid.Column="2"
                                    SelectedDate="{Binding FilterEndDate, Mode=TwoWay}"
                                    Style="{StaticResource InputDatePickerStyle}"
                                    ToolTip="结束日期" />
                    </Grid>
                </StackPanel>
                <StackPanel Width="120" Margin="0,0,10,0">
                    <TextBlock Text="维修人员" Style="{StaticResource FormLabelStyle}" />
                    <ComboBox ItemsSource="{Binding RepairPersonFilters}"
                              SelectedItem="{Binding SelectedRepairPersonFilter}"
                              Style="{StaticResource InputComboBoxStyle}" />
                </StackPanel>
                <StackPanel Width="120" Margin="0,0,10,0">
                    <TextBlock Text="维修方式" Style="{StaticResource FormLabelStyle}" />
                    <ComboBox ItemsSource="{Binding RepairMethodFilters}"
                              SelectedItem="{Binding SelectedRepairMethodFilter}"
                              Style="{StaticResource InputComboBoxStyle}" />
                </StackPanel>
                <StackPanel Width="96" Margin="0,0,10,0">
                    <TextBlock Text="记录状态" Style="{StaticResource FormLabelStyle}" />
                    <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                              SelectedItem="{Binding SelectedStatusFilter}"
                              Style="{StaticResource InputComboBoxStyle}" />
                </StackPanel>
                <StackPanel Margin="0,21,12,0">
                    <Button Content="清除筛选"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,7"
                            Click="ClearFilters_Click" />
                </StackPanel>
                <TextBlock Text="{Binding MatchedRecordCount, StringFormat=筛选结果 {0} 条}"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,11" />
            </WrapPanel>
        </Border>

        <DataGrid x:Name="RecordsGrid"
                  Grid.Row="3"
                  ItemsSource="{Binding FilteredRecords}"
                  SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  MouseDoubleClick="RecordsGrid_MouseDoubleClick">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White" />
                    <Setter Property="BorderBrush" Value="#EDF1EF" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Parked">
                            <Setter Property="Background" Value="#F7D8D5" />
                            <Setter Property="Foreground" Value="#852D27" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Incomplete">
                            <Setter Property="Background" Value="#FFF0E6" />
                            <Setter Property="Foreground" Value="#8B5736" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="维修编号" Width="178" Binding="{Binding OrderNumber}" />
                <DataGridTextColumn Header="接单时间" Width="126" Binding="{Binding WorkDateTimeText}" />
                <DataGridTextColumn Header="维修地点" Width="150" Binding="{Binding Location}" />
                <DataGridTextColumn Header="事件与联系方式" Width="*" Binding="{Binding RepairReason}" />
                <DataGridTextColumn Header="维修人员" Width="92" Binding="{Binding RepairPerson}" />
                <DataGridTextColumn Header="维修方式" Width="112" Binding="{Binding RepairMethod}" />
                <DataGridTextColumn Header="状态" Width="70" Binding="{Binding StatusText}" />
                <DataGridTextColumn Header="费用" Width="88" Binding="{Binding TotalCost, StringFormat=¥{0:0.00}}" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <TextBlock Text="挂单为深红底，未完成保存为浅红底，资料完整为无底色"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,18,0" />
            <Button Content="编辑记录"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0"
                    Click="EditRecord_Click" />
            <Button Content="导出选中记录 PDF"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,0,8,0"
                    Click="GenerateSelectedPdf_Click" />
            <Button Content="删除记录"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="DeleteRecord_Click" />
        </StackPanel>
    </Grid>
</UserControl>
